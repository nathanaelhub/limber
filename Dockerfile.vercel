# Limber's public demo on Vercel (container image). A simulated clinic only: the record lives in temporary
# storage, is seeded when an instance starts, and is lost when it scales to zero. Never use it for real patients.
# The self-hosted image is deploy/Dockerfile; both share deploy/entrypoint.sh.
FROM python:3.13-slim

# LIMBER_DEMO_DB: the container's own disk is temporary, so the demo record goes under /tmp.
# PORT: Caddy routes this one port to both apps; 8080 because the app does not run as root.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    LIMBER_DEMO=1 LIMBER_DEMO_DB=/tmp/limber/demo.db PORT=8080 HOME=/tmp/limber-home

RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 tini curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=caddy:2 /usr/bin/caddy /usr/local/bin/caddy

WORKDIR /app
COPY requirements.txt .
# CPU-only torch in its own layer: the registry refuses a compressed layer over 500 MB.
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch torchvision
RUN pip install -r requirements.txt

COPY . .
RUN python scripts/fetch_portal_assets.py
RUN mkdir -p models && curl -fsSL -o models/yolo11m-pose.pt \
        https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11m-pose.pt \
    && echo "29b17eaf3a3117cbea906090dbedf9159f7c6a49db58ec8b99ed2dfde1cf6eb2  models/yolo11m-pose.pt" | sha256sum -c -

RUN useradd --create-home --uid 10001 limber && chown -R limber:limber /app
USER limber
EXPOSE 8080

ENTRYPOINT ["/usr/bin/tini", "--", "/app/deploy/entrypoint.sh"]

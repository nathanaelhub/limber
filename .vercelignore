# What a `vercel deploy` from the repository root would upload. The hosted demo deploys with
# scripts/deploy_vercel.sh, which uses deploy/vercel/.vercelignore; this one keeps secrets out either way.
.env
.env.*
data/
.venv/
.git/
.github/
.claude/
.specify/
.pytest_cache/
__pycache__/
**/__pycache__/
*.pyc
.DS_Store
.playwright-mcp/
deploy/secrets/
deploy/limber.env
exports/
sessions/
observation_logs/
output/
models/*.pt
videos/
design/
docs/user-cases/
